-- b) Let's assume that a supplier closes production at Christmas and does not deliver if more than 50% of the 
-- country's population is Christian. Which suppliers do not deliver during Christmas? (4784


select 
    S.s_name as Supplier_Name,
	C.name as Country, 
	R.percentage, 
	R.name as Religion,
	N.n_name as Nation 
	
from public.Supplier S
	
inner join public.nation N on N.n_nationkey = S.s_nationkey
inner join mondial.country C on lower(N.n_name) = lower(C.name)
inner join mondial.religion R on C.code = R.country

WHERE 
    R.percentage > 50
and R.name LIKE  '%Christian%';
;


