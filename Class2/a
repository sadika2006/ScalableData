-- d) How many different parts are produced in the EU? (1 ) 79710
SELECT COUNT(DISTINCT P.p_partkey) AS PartsProducedInEU
FROM public.PART P
INNER JOIN public.PARTSUPP PS ON P.p_partkey = PS.ps_partkey
INNER JOIN public.SUPPLIER S ON PS.ps_suppkey = S.s_suppkey
INNER JOIN public.NATION N ON S.s_nationkey = N.n_nationkey
INNER JOIN mondial.country C ON lower(N.n_name) = lower(C.name)
INNER JOIN mondial.isMember M ON C.code = M.country
WHERE M.organization = 'EU'
AND M.type = 'member';
