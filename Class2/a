-- a) Which suppliers are located in a country with a population greater than 30 Mio.? (8423

select S.s_name as Name, N.n_name as Nation from public.Supplier S
inner join public.nation N on N.n_nationkey = S.s_nationkey
inner join mondial.country C on lower(N.n_name) = lower(C.name)
WHERE 
    C.Population > 30000000;
;

